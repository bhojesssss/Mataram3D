<file path="src/index.css">
@import 'tailwindcss';

/* ════════════════════════════════════════════════════════════════════════
   MATARAM — design tokens
   Palet, tipografi, dan easing diangkat dari referensi/moodboard.png.
   Semua yang didaftarkan di @theme otomatis jadi utility Tailwind:
   --color-forest  →  bg-forest / text-forest / border-forest
   --font-display  →  font-display
   --ease-heritage →  ease-heritage
   ════════════════════════════════════════════════════════════════════════ */

@theme {
  /* Enam swatch moodboard, kiri ke kanan. */
  --color-forest: #2c4a34;
  --color-sage: #93a98d;
  --color-gold: #c9a34e;
  --color-tan: #dcc89a;
  --color-cream: #e8e2d0;
  --color-paper: #f7f4ec;

  /* Turunan, bukan warna baru: gelap untuk kontras, terang untuk kartu. */
  --color-forest-deep: #1b2f21;
  --color-forest-mid: #3a5c44;
  /*
    --gold di atas --paper cuma ~1.9:1 dan tidak pernah boleh jadi warna teks;
    ia untuk garis, simpul, dan ornamen. Dua turunan di bawah dihitung terhadap
    kasus terburuk homepage: teks di dalam band (paper 88%) yang kebetulan
    jatuh di atas sirap atap yang gelap.

      --color-gold-deep  5.61:1   (dulu #7a5f2b — gagal di kondisi ini)
      --color-ink-soft   5.89:1   (dulu #5c6a58 — 3.82:1, gagal)

    Keduanya sengaja masih di bawah --color-ink supaya hirarki teks primer vs
    sekunder tetap kebaca; yang berubah cuma lantainya.
  */
  --color-gold-deep: #6b5220;
  --color-ink: #23301f;
  --color-ink-soft: #485742;

  /*
    ── BAND ────────────────────────────────────────────────────────────────

    Struktur halaman ini cuma satu kalimat: 3D-nya adalah halaman di dua
    momen — hero dan Palace — dan di antaranya sebuah pelat paper menutupinya
    supaya orang bisa membaca.

    Itu menggantikan dua percobaan sebelumnya. Scrim global gagal karena
    render-nya tidak seragam: langit terang dan massa pendopo gelap ada di
    layar yang sama, jadi satu angka opacity harus memilih salah satunya dan
    selalu salah untuk yang lain. Surface per-blok memperbaiki kontrasnya
    tapi memecah halaman jadi sebelas kartu ngambang.

    Band menyelesaikan keduanya karena ia dipotong menurut NARASI, bukan
    menurut tiap blok teks: satu pelat untuk seluruh rentang baca, berhenti
    tepat di Palace, lalu lanjut lagi. Pemudaran di ujung band pertama itulah
    reveal-nya Palace — putihnya mengelupas, interiornya muncul.
  */
  --surface-tint: 247 244 236; /* --color-paper, sebagai channel RGB */

  /*
    88%: cukup pekat untuk menjamin teks (semua warna >= 5.6:1 bahkan di atas
    bagian render tergelap), cukup tembus untuk pendoponya tetap terbaca
    sebagai gambar di belakang teks, bukan sekadar tekstur.

    Sengaja TANPA backdrop-filter. Band ini selebar viewport dan setinggi
    beberapa layar; blur seluas itu di atas canvas yang sedang menggambar
    scene 3D adalah biaya fill rate paling mahal yang bisa ditambahkan ke
    halaman ini — dan pada 88% hasilnya nyaris tak terlihat. Yang justru
    dibeli orang di angka 88% adalah MELIHAT pendoponya; mem-blur-nya
    membatalkan alasan angka itu dipilih.
  */
  --band-alpha: 0.88;

  /*
    Panjang pemudaran di ujung band. Ini variabel kerajinan utama di halaman
    ini: kependekan terbaca sebagai potongan, kepanjangan bikin reveal Palace
    lembek. Diikat ke vh supaya pemudarannya tetap sebanding dengan layar,
    bukan dengan panjang section.

    Angka ini juga jadi padding band (lihat @utility band), jadi menaikkannya
    menambah ruang kosong sungguhan di tiga tempat: sesudah hero, sebelum
    Palace, dan sesudah Palace. Ditahan di 16vh — bukan 20vh seperti percobaan
    pertama — karena di atas itu jeda sebelum reveal mulai terasa seperti
    halaman kehabisan isi, bukan seperti tarikan napas.
  */
  --band-fade: clamp(120px, 16vh, 220px);

  --font-display: 'Cormorant Garamond', 'Times New Roman', serif;
  --font-body: 'Inter', system-ui, -apple-system, sans-serif;

  /* PDF §8 "slow & dignified motion" — satu easing untuk seluruh situs. */
  --ease-heritage: cubic-bezier(0.22, 0.61, 0.36, 1);

  --animate-breathe: breathe 2.6s ease-in-out infinite;
  --animate-scroll-tick: scroll-tick 2.4s var(--ease-heritage) infinite;
  --animate-fade-in: fade-in 0.35s var(--ease-heritage) both;
  --animate-era-in: era-in 0.5s var(--ease-heritage) both;

  @keyframes breathe {
    0%,
    100% {
      opacity: 0.35;
      transform: scale(0.94);
    }
    50% {
      opacity: 1;
      transform: scale(1.04);
    }
  }

  @keyframes scroll-tick {
    0% {
      transform: translateY(-100%);
    }
    60%,
    100% {
      transform: translateY(100%);
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes era-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
}

/* ── base ──────────────────────────────────────────────────────────────── */

@layer base {
  html {
    /* Lenis yang menggerakkan scroll; smooth-scroll native akan berkelahi. */
    scroll-behavior: auto;
    -webkit-text-size-adjust: 100%;
  }

  body {
    @apply bg-cream text-ink font-body text-base font-light leading-[1.7] antialiased;
    overflow-x: hidden;
  }

  /*
    Reveal homepage digerakkan GSAP, jadi state awalnya harus CSS.
    Digerbangi .has-js: kalau scene 3D gagal boot, kelasnya dilepas dan
    seluruh isi halaman tetap terbaca alih-alih blank.
  */
  .has-js [data-reveal] {
    opacity: 0;
    transform: translateY(26px);
    will-change: opacity, transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .has-js [data-reveal] {
      opacity: 1;
      transform: none;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
}

/* ── utility yang tidak bisa diungkapkan class bawaan ──────────────────── */

/*
  ── BAND ──────────────────────────────────────────────────────────────────

  Pelat paper selebar viewport yang menutupi render 3D sepanjang rentang
  baca. Dipasang sebagai lapisan absolut di belakang isinya, bukan sebagai
  latar elemen isi, karena mask-nya hanya boleh mengenai pelat — kalau
  dipasang langsung di wadah isi, teksnya ikut memudar di ujung band.

  `--band-head` / `--band-foot` mengatur ujung mana yang memudar. Band kedua
  mengakhiri halaman dengan bertemu footer hijau yang solid, jadi ujung
  bawahnya dipotong rata (0px) — pemudaran di situ cuma akan bikin pita
  transisi kotor sebelum warna berganti total.
*/
/*
  Padding = panjang fade, dan itu BUKAN kosmetik — itu yang bikin sistem ini
  benar.

  Versi pertama tidak punya padding: pelatnya seukuran isinya, jadi zona
  pemudaran jatuh tepat di atas section pertama dan terakhir tiap band. Kicker
  "THE ROYAL HOUSE" mendarat di tengah pudaran dan kontrasnya anjlok di bawah
  angka yang sudah diverifikasi — audit meloloskannya karena audit mengukur
  alpha penuh, sementara teks itu tidak pernah mendapat alpha penuh.

  Dengan padding sepanjang fade, kotak isi dimulai persis di titik mask
  mencapai 100%. Jadi setiap huruf di dalam band dijamin duduk di atas alpha
  penuh, dan seluruh pemudaran terjadi di ruang kosong. Padding yang lebih
  kecil dari fade akan membocorkan teks ke dalam pudaran lagi.

  Satu variabel menggerakkan keduanya, jadi mask dan padding tidak akan pernah
  bisa tidak sepakat: band kedua menyetel --band-foot: 0px dan dengan sendirinya
  kehilangan pemudaran bawah DAN padding bawahnya, lalu bertemu footer rata.
*/
@utility band {
  position: relative;
  isolation: isolate;
  padding-top: var(--band-head, var(--band-fade));
  padding-bottom: var(--band-foot, var(--band-fade));
}

@utility band-plate {
  position: absolute;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  background: rgb(var(--surface-tint) / var(--band-alpha));
  mask-image: linear-gradient(
    to bottom,
    transparent 0,
    #000 var(--band-head, var(--band-fade)),
    #000 calc(100% - var(--band-foot, var(--band-fade))),
    transparent 100%
  );
  -webkit-mask-image: linear-gradient(
    to bottom,
    transparent 0,
    #000 var(--band-head, var(--band-fade)),
    #000 calc(100% - var(--band-foot, var(--band-fade))),
    transparent 100%
  );
}

/*
  ── SURFACE WASH ──────────────────────────────────────────────────────────

  Sisa dari sistem sebelumnya, dan sekarang tinggal satu pemakai: sub-copy
  hero, satu-satunya teks di halaman ini yang duduk di luar band. Varian
  `glass` yang dulu ada di sini sudah dihapus — band membuatnya mubazir, dan
  bersamanya hilang pula seluruh backdrop-filter dari homepage.
*/
@utility surface-wash {
  position: relative;
  isolation: isolate;

  /*
    GEOMETRI — jangan diubah tanpa menghitung ulang.

    Percobaan pertama pakai `ellipse 70% 65%` dengan stop penuh hanya di titik
    pusat, dan hasilnya gagal audit: pada radial-gradient, persentase radius
    dihitung terhadap LEBAR dan TINGGI kotak (bukan setengahnya), jadi tepi
    kanan-kiri teks jatuh di ~64% sepanjang sinar gradien — tempat alpha sudah
    tinggal setengahnya. Di sudut lebih parah lagi (jarak ternormalisasi 0.92,
    alpha praktis nol). Teks di tepi blok praktis tidak punya wash sama sekali.

    Susunan sekarang menaruh SELURUH kotak isi di dalam dataran alpha penuh:
      ::before = 1.32× lebar isi, 1.52× tingginya (inset -26% -16%)
      radius 94%/80%  → tepi isi jatuh di ~40% sepanjang sinar
      sudut terjauh   → sqrt(0.40² + 0.41²) ≈ 0.58, masih di dalam stop 58%
    Jadi setiap huruf duduk di atas alpha penuh dan pemudarannya seluruhnya
    terjadi di luar teks — itu yang bikin wash bisa dijamin sama amannya
    dengan band meski tidak punya tepi.

    Overhang-nya sengaja besar. Versi sebelumnya cuma -8%/-6%, dan dengan
    dataran yang menutupi seluruh isi, pita pemudarnya jadi terlalu sempit
    untuk dilihat sebagai pudaran — hero-nya terbaca sebagai kartu pucat yang
    ditempel di atas pendopo, persis yang harus dihindari. Sekarang pita itu
    selebar ~0.5× lebar bloknya sendiri, jadi ia terbaca sebagai kabut, bukan
    tepi. Moodboard-nya memang begitu: hero-nya berkabut pucat dengan keraton
    samar di bawahnya.
  */
  &::before {
    content: '';
    position: absolute;
    inset: -26% -16%;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      ellipse 94% 80% at 50% 50%,
      rgb(var(--surface-tint) / var(--band-alpha)) 0%,
      rgb(var(--surface-tint) / var(--band-alpha)) 58%,
      rgb(var(--surface-tint) / calc(var(--band-alpha) * 0.5)) 78%,
      rgb(var(--surface-tint) / 0) 100%
    );
  }
}

/*
  Satu-satunya kepekatan di halaman ini, jadi band dan wash tidak akan pernah
  bisa berbeda diam-diam. Di sini dinaikkan mendekati pekat: orang yang
  meminta transparansi dikurangi tidak sedang meminta pendopo samar di balik
  teks. Hook tier render yang dulu ada di sini sudah dihapus bersama
  backdrop-filter-nya — tidak ada lagi yang perlu diturunkan per GPU.
*/
@media (prefers-reduced-transparency: reduce) {
  :root {
    --band-alpha: 0.97;
    --glass-alpha: 0.96;
  }
}

/*
  Kaca cair — panel lepas yang mengambang di atas halaman (menu mobile).

  Bedanya dengan kaca buram biasa ada di tepinya: garis sorot putih di atas,
  pantulan tipis di bawah, dan kilap miring di permukaannya, jadi panelnya
  terbaca sebagai benda tebal yang membiaskan cahaya, bukan sekadar lapisan
  susu. Saturasi dinaikkan supaya warna di belakangnya tetap hidup setelah
  diburamkan. Tint 72%: di bawah itu teks sekunder mulai tenggelam saat
  panelnya menutupi bagian pendopo yang gelap.

  Hanya untuk panel seukuran komponen. Jangan dipasang di permukaan selebar
  viewport dan setinggi beberapa layar — lihat catatan --band-alpha soal
  biaya blur di atas canvas 3D.
*/
@utility liquid-glass {
  background:
    linear-gradient(
      160deg,
      rgb(255 255 255 / 0.5),
      rgb(255 255 255 / 0.08) 38%,
      rgb(255 255 255 / 0) 62%,
      rgb(255 255 255 / 0.16)
    ),
    rgb(var(--surface-tint) / var(--glass-alpha, 0.72));
  -webkit-backdrop-filter: blur(22px) saturate(180%);
  backdrop-filter: blur(22px) saturate(180%);
  border: 1px solid rgb(255 255 255 / 0.55);
  box-shadow:
    inset 0 1px 0 rgb(255 255 255 / 0.8),
    inset 0 -1px 1px rgb(255 255 255 / 0.25),
    0 24px 60px -16px rgb(27 47 33 / 0.38),
    0 2px 8px rgb(27 47 33 / 0.08);
}

/*
  Halo krem — sisa dari sebelum ada sistem surface. Sekarang dipakai HANYA
  untuk elemen lepas yang memang tidak boleh punya panel: penanda SCROLL di
  hero. Jangan dipakai lagi untuk badan teks; text-shadow 24px tidak sanggup
  mengisi celah antar huruf pada ukuran 0.92rem, dan di atas surface hasilnya
  justru buram.
*/
@utility halo {
  text-shadow:
    0 1px 10px rgb(247 244 236 / 0.92),
    0 0 24px rgb(247 244 236 / 0.8);
}

/* Arsiran emas untuk frame foto yang filenya belum ada. */
@utility hatch {
  background-image: repeating-linear-gradient(
    45deg,
    transparent 0 9px,
    rgb(201 163 78 / 0.07) 9px 10px
  );
}

/* Scrollbar default berupa balok abu di tengah timeline emas. */
@utility rail-scroll {
  scrollbar-width: thin;
  scrollbar-color: rgb(201 163 78 / 0.35) transparent;

  &::-webkit-scrollbar {
    height: 4px;
  }
  &::-webkit-scrollbar-track {
    background: transparent;
  }
  &::-webkit-scrollbar-thumb {
    background: rgb(44 74 52 / 0.25);
    border-radius: 4px;
  }
}

/*
  ── LOADER ASAP ───────────────────────────────────────────────────────────

  Tirai pembuka homepage (components/home/Loader.jsx). Semua geraknya di
  sini supaya komponennya cukup menukar satu class `is-leaving`.

  Urutan waktunya — ubah satu angka, periksa yang lain:
    0.00s  gumpalan tepi mulai bergulung masuk (1.1s); yang di tengah
           menyusul, paling lambat 0.28s
    0.80s  logo muncul (0.55s) — mulai saat asap sudah hampir rapat
    ...    tertahan sampai scene siap; asap terus bergolak
    exit   logo hilang (0.32s)
           kabut dasar memudar mulai 0.15s (0.5s)
           gumpalan tersibak mulai 0.22s, tengah lebih dulu, yang paling
           luar menyusul 0.3s kemudian (1.2s) — total ±1.7s, jauh di bawah
           jaring pengaman 3s di Loader.jsx

  Per gumpalan, dari Loader.jsx: --away (arah dan jarak pergi), --in / --out
  (jeda masuk dan keluar), --drift (arah golakan).
*/
@layer components {
  /* Asap bagian dalam: lebih gelap dari gumpalan, dan makin gelap ke tepi. */
  .loader-haze {
    background: radial-gradient(ellipse at 50% 45%, #cfc8bb, #a89e8e);
  }
  .loader-haze.is-leaving {
    animation: loader-haze-out 0.5s ease-out 0.15s both;
  }

  .smoke-puff {
    position: absolute;
    translate: -50% -50%;
    animation: loader-smoke-in 1.1s cubic-bezier(0.16, 1, 0.3, 1) var(--in) both;
  }
  .smoke.is-leaving .smoke-puff {
    animation: loader-smoke-out 1.2s cubic-bezier(0.55, 0, 0.35, 1) calc(0.22s + var(--out)) both;
  }

  /*
    Badan gumpalan, dua lapis:
      1. teduh di perut bawah
      2. badan yang terang di atas pusat dan menipis ke tepi, tanpa garis luar
    Pusat badannya digeser sedikit ke atas, jadi puncaknya yang paling terang
    dan tidak perlu lapis sorot sendiri — sorot terpisah (percobaan pertama)
    terbaca sebagai kilap oval, dan asapnya jadi mirip jok kulit.

    Tepinya sengaja memudar ke warna terang, bukan menggelap: kalau tepinya
    gelap, begitu kabut dasar hilang saat tirai dibuka tiap gumpalan terbaca
    sebagai bola. Gelapnya kedalaman asap datang dari kabut dasar di celahnya.
  */
  .smoke-billow {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background:
      radial-gradient(42% 20% at 52% 78%, rgb(132 122 104 / 0.3), rgb(132 122 104 / 0)),
      radial-gradient(
        47% 47% at 50% 45%,
        #faf9f5 0%,
        #eeeae2 36%,
        rgb(226 220 209 / 0.95) 58%,
        rgb(216 209 197 / 0.55) 78%,
        rgb(216 209 197 / 0) 95%
      );
    animation: smoke-billow 7s ease-in-out infinite;
  }

  .loader-logo {
    animation: loader-logo-in 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) 0.8s both;
  }
  .loader-logo.is-leaving {
    animation: loader-logo-out 0.32s cubic-bezier(0.55, 0, 1, 0.45) both;
  }
}

@keyframes loader-haze-out {
  to {
    opacity: 0;
  }
}

/* Asap berkumpul: datang dari luar dalam keadaan tipis dan mengembang, lalu memadat. */
@keyframes loader-smoke-in {
  from {
    opacity: 0;
    transform: var(--away) scale(1.4);
  }
  50% {
    opacity: 1;
  }
}

/* Kebalikannya: bergeser keluar sambil mengembang, lalu buyar di paruh akhir. */
@keyframes loader-smoke-out {
  45% {
    opacity: 1;
  }
  to {
    opacity: 0;
    transform: var(--away) scale(1.4);
  }
}

@keyframes smoke-billow {
  50% {
    transform: var(--drift) scale(1.1);
  }
}

@keyframes loader-logo-in {
  from {
    opacity: 0;
    transform: scale(0.7);
  }
}

@keyframes loader-logo-out {
  to {
    opacity: 0;
    transform: scale(0.85);
  }
}

/*
  ── MENU MOBILE ───────────────────────────────────────────────────────────

  Gerak components/layout/MobileMenu.jsx.

  Buka: veil memudar masuk (0.4s); panel turun dari balik tepi atas layar
  dengan kurva yang melambat panjang tanpa memantul (0.55s); isinya menyusul
  baris demi baris searah panel, 35ms antar baris, mulai 0.08s.
  Tutup: panel naik kembali ke atas, makin cepat sampai hilang (0.32s) —
  lebih cepat dari buka, karena orang yang menutup menu sudah selesai
  dengannya, jangan disuruh menunggu.

  Jarak geser -100% ditambah 40px: 10px celah panel dari tepi atas, sisanya
  bayangan panel, supaya bayangannya pun tidak tertinggal di layar.
*/
@layer components {
  .menu-veil {
    background: rgb(27 47 33 / 0.22);
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
    animation: menu-fade-in 0.4s var(--ease-heritage) both;
  }
  .menu-veil.is-leaving {
    animation: menu-fade-out 0.32s ease-in both;
  }

  .menu-sheet {
    animation: menu-sheet-in 0.55s cubic-bezier(0.32, 0.72, 0, 1) both;
  }
  .menu-sheet.is-leaving {
    animation: menu-sheet-out 0.32s cubic-bezier(0.4, 0, 1, 1) both;
  }

  .menu-item {
    animation: menu-item-in 0.5s cubic-bezier(0.32, 0.72, 0, 1) calc(0.08s + var(--i, 0) * 35ms) both;
  }
}

@keyframes menu-fade-in {
  from {
    opacity: 0;
  }
}

@keyframes menu-fade-out {
  to {
    opacity: 0;
  }
}

@keyframes menu-sheet-in {
  from {
    transform: translateY(calc(-100% - 40px));
  }
}

@keyframes menu-sheet-out {
  to {
    transform: translateY(calc(-100% - 40px));
  }
}

@keyframes menu-item-in {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
}

/* <dialog> backdrop tidak bisa disentuh utility class. */
@layer components {
  dialog::backdrop {
    background: rgb(24 34 27 / 0.72);
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
  }
}
